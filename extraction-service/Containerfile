FROM python:3.14-slim-trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxcb1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.13.*

RUN useradd -m extraction_service

WORKDIR /extraction-service
RUN chown extraction_service /extraction-service

USER extraction_service

COPY pyproject.toml pyproject.toml
COPY uv.lock uv.lock

RUN uv sync --locked --compile-bytecode --no-cache --no-default-groups

RUN .venv/bin/docling-tools models download layout tableformer rapidocr -o /extraction-service/models

ENV DOCLING_ARTIFACTS_PATH=/extraction-service/models

COPY src src

EXPOSE 8080

ENV PATH="/extraction-service/.venv/bin:$PATH"

ENTRYPOINT ["granian", "--port", "8080", "--host", "0.0.0.0", "--interface", "asgi", "src.main:app"]
