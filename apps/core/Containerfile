FROM python:3.14-slim-trixie

RUN pip install --no-cache-dir uv==0.13.*

RUN useradd -r -u 10001 prawobiorca_app

WORKDIR /core
RUN chown prawobiorca_app /core


USER prawobiorca_app

COPY pyproject.toml pyproject.toml
COPY uv.lock uv.lock
RUN uv sync --locked --no-install-project --compile-bytecode --no-cache --no-default-groups

ENV PATH="/core/.venv/bin:$PATH"

COPY src src
RUN uv sync --locked --no-editable --compile-bytecode --no-cache --no-default-groups

COPY alembic.ini alembic.ini
COPY alembic alembic

EXPOSE 8000

CMD ["granian", "--port", "8000", "--host", "0.0.0.0", "--interface", "asgi", "core_service.main:prawobiorca"]
