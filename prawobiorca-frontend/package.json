{
  "name": "prawobiorca-frontend",
  "version": "0.32.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "oxfmt src/",
    "generate:api-client": "orval",
    "check": "run-s check:*",
    "check:oxlint": "oxlint .",
    "check:eslint": "eslint . --cache",
    "check:stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "check:format": "oxfmt --check src/",
    "check:knip": "knip"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-vue/material-symbols": "^1.0.50",
    "axios": "^1.21.0",
    "docx-preview": "^0.4.1",
    "element-plus": "^2.14.7",
    "md-editor-v3": "^7.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "npm-run-all2": "^9.0.4",
    "orval": "^8.46.0",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@11.24.0"
}
